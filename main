    hamburgerLineWidth: {
        type: ControlType.Enum,
        title: "Hamburger Line Width",
        description: "Thickness of the hamburger menu lines",
        options: [1, 2],
        optionTitles: ["Thin", "Thick"],
        defaultValue: 2,
        displaySegmentedControl: true,
    },
    backgroundColor: {
        type: ControlType.Color,
        title: "Background Color",
        description: "Background color of the menu container",
        defaultValue: "#FFFFFF",
    },
    useGlassEffect: {
        type: ControlType.Boolean,
        title: "Glass Effect",
        description:
            "Enable frosted glass effect with light refraction and chromatic aberration",
        defaultValue: false,
        enabledTitle: "On",
        disabledTitle: "Off",
    },
    containerPadding: {
        type: ControlType.Padding,
        title: "Container Padding",
        description: "Padding around the menu container",
        defaultValue: "16px 48px",
    },
    showDividers: {
        type: ControlType.Boolean,
